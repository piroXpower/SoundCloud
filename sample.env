# ========================================================
# SoundCloud Telegram Music Bot - Configuration File
# ========================================================

# Get API_ID and API_HASH from https://my.telegram.org
API_ID=12345678
API_HASH=your_api_hash_here

# Get BOT_TOKEN from @BotFather on Telegram
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Assistant Telegram User Account Pyrogram String Session
# (Required for joining voice chats and streaming audio)
SESSION_STRING=your_assistant_session_string_here

# Owner Telegram User ID & Sudo Users (separated by spaces)
OWNER_ID=123456789
SUDO_USERS=123456789 987654321

# Bot Details
BOT_NAME="SoundCloud Music"
BOT_USERNAME="YourSoundCloudMusicBot"

# Support & Updates Links
SUPPORT_GROUP="https://t.me/YourSupportGroup"
UPDATES_CHANNEL="https://t.me/YourUpdatesChannel"

# Image Banner for /start
START_IMAGE_URL="https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?q=80&w=1280&auto=format&fit=crop"

# Audio Settings
DEFAULT_VOLUME=100
DURATION_LIMIT_MINUTES=180
